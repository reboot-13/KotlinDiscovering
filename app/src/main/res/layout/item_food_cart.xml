<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="380dp"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="?android:attr/selectableItemBackground">

    <ImageView
        android:id="@+id/imgView"
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:contentDescription="fila"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/ic_food_avatar"
        />

    <TextView
        android:id="@+id/foodLabelTextView"
        android:layout_width="wrap_content"
        android:maxWidth="180dp"
        app:layout_constraintHorizontal_bias="0"
        android:layout_height="0dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="15dp"
        android:gravity="center_vertical"
        tools:text="Филадельфия"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@+id/imgView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/imgView" />

    <TextView
        android:id="@+id/foodQuantityTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        tools:text="x 2"
        android:layout_marginStart="5dp"
        android:textColor="@color/black"
        android:textSize="16sp"
        app:layout_constraintStart_toEndOf="@id/foodLabelTextView"
        app:layout_constraintBottom_toBottomOf="@id/foodLabelTextView"
        app:layout_constraintTop_toTopOf="@id/foodLabelTextView"/>

    <TextView
        android:id="@+id/foodCostTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="10dp"
        tools:text="= 680 р"
        android:textStyle="italic"
        android:textSize="20sp"
        app:layout_constraintStart_toEndOf="@+id/imgView"
        app:layout_constraintTop_toBottomOf="@+id/foodLabelTextView" />


    <EditText
        android:id="@+id/editFoodQuantity"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@null"
        android:ems="10"
        android:inputType="number"
        android:text="0"
        android:textAlignment="center"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/foodQuantityDown"
        app:layout_constraintTop_toTopOf="@id/foodQuantityDown"
        />


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/foodQuantityDown"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="15dp"
        android:background="@drawable/minus_button"
        app:layout_constraintStart_toEndOf="@+id/imgView"
        app:layout_constraintTop_toBottomOf="@+id/foodCostTextView" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/foodQuantityUp"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/plus_button"
        app:layout_constraintStart_toEndOf="@id/editFoodQuantity"
        app:layout_constraintTop_toTopOf="@id/foodQuantityDown" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="imgView, editFoodQuantity"
        app:barrierDirection="bottom"/>

    <View
        android:layout_width="wrap_content"
        android:layout_height="15dp"
        app:layout_constraintTop_toBottomOf="@id/barrier" />

</androidx.constraintlayout.widget.ConstraintLayout>